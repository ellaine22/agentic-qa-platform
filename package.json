{
  "name": "agentic-qa-platform",
  "version": "0.1.0",
  "description": "Agentic QA platform prototype: orchestrated test planning, execution, automation and coverage for web (Cypress) and mobile (Maestro)",
  "type": "module",
  "bin": {
    "qa": "./src/cli.js"
  },
  "scripts": {
    "qa": "node src/cli.js",
    "demo": "node src/cli.js demo",
    "report": "node src/cli.js report",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "cypress": "^16.1.1"
  },
  "engines": {
    "node": ">=22.23.5 <23 || >=24.22.3 <25 || >=26.13.1"
  },
  "license": "MIT"
}
